{
  "permissions": {
    "allow": [
      "Bash(git config *)",
      "Bash(npx tsc *)",
      "Bash(echo \"EXIT: $?\")",
      "PowerShell(Test-Path node_modules; Test-Path dist; \\(Get-ChildItem node_modules -ErrorAction SilentlyContinue | Measure-Object\\).Count)",
      "PowerShell(npm install 2>&1 | Select-Object -Last 15; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npx tsc --noEmit 2>&1 | Select-Object -First 40; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npm run build 2>&1 | Select-Object -Last 8; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(node scripts/verify-tools.mjs 2>&1 | Select-Object -Last 20; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(& \"node_modules/electron/dist/electron.exe\" --version 2>&1 | Select-Object -First 5; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npx tsc --noEmit 2>&1 | Select-Object -First 30; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npm run build 2>&1 | Select-Object -Last 6; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npm test 2>&1 | Select-Object -Last 20; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npm test 2>&1 | Select-Object -Last 35; \"EXIT: $LASTEXITCODE\")",
      "PowerShell(npm test 2>&1 | Select-String -Pattern \"^# \\(tests|pass|fail|suites|todo|skipped\\)|duration_ms|failing tests\" | Select-Object -First 20; \"EXIT: $LASTEXITCODE\")"
    ]
  }
}
