{
  "name": "photon-mixer",
  "version": "0.1.2",
  "description": "Digital-native illustration software with float32 linear color and GPU-native architecture",
  "author": "iwabuchi404",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc && node scripts/copy-assets.mjs && cross-env PM_DEV=1 electron .",
    "watch": "tsc --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@webgpu/types": "^0.1.70",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.62.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lit": "^3.3.3"
  },
  "build": {
    "appId": "com.photonmixer.app",
    "productName": "PhotonMixer",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "dist/**/*",
      "node_modules/fflate/**/*",
      "node_modules/lit/**/*",
      "node_modules/lit-html/**/*",
      "node_modules/lit-element/**/*",
      "node_modules/@lit/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-universal.dmg",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    }
  }
}
